@article{maigaGeneratingStatisticsHealth2019,
  title = {Generating Statistics from Health Facility Data: The State of Routine Health Information Systems in {{Eastern}} and {{Southern Africa}}},
  shorttitle = {Generating Statistics from Health Facility Data},
  author = {Ma{\"i}ga, Abdoulaye and Jiwani, Safia S and Mutua, Martin Kavao and Porth, Tyler Andrew and Taylor, Chelsea Maria and Asiki, Gershim and Melesse, Dessalegn Y and Day, Candy and Strong, Kathleen L and Faye, Cheikh Mback{\'e} and Viswanathan, Kavitha and O'Neill, Kathryn Patricia and Amouzou, Agbessi and Pond, Bob S and Boerma, Ties},
  year = 2019,
