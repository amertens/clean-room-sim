@article{adhikariMaternalDietaryIntake2022,
  title = {Maternal Dietary Intake, Nutritional Status and Macronutrient Composition of Human Breast Milk: Systematic Review},
  shorttitle = {Maternal Dietary Intake, Nutritional Status and Macronutrient Composition of Human Breast Milk},
  author = {Adhikari, Shiksha and Kudla, Urszula and Nyakayiru, Jean and {Brouwer-Brolsma}, Elske M.},
  year = 2022,
  month = jun,
  journal = {British Journal of Nutrition},
  volume = {127},
  number = {12},
  pages = {1796--1820},
  issn = {0007-1145, 1475-2662},
  doi = {10.1017/S0007114521002786},
  urldate = {2025-10-01},
  abstract = {Human breast milk (BM) is the best source of nutrition in early life, particularly during the first 6 months. Nevertheless, human BM composition is variable, and more insight in the exact factors contributing to this variability is warranted. In this review, we explored the impact of maternal dietary intake and nutritional status (e.g. anthropometric measures, BMI, bioimpedance) on human milk macronutrient composition. PubMed, Scopus and Cochrane were systematically searched till November 2019. In total, 4946 publications underwent title--abstract screening; 101 publications underwent full-text screening. Eventually, fifty publications were included in this review, investigating either associations between maternal dietary intake (n 29) and/or maternal nutritional status (n 29), and macronutrient composition of human BM. Reported energy composition ranged from 213 to 301 kJ/100 ml, and 67 \% and 54 \% of the studies reported associations between with maternal nutritional intake and status, respectively. Protein content ranged from 0{$\cdot$}8 to 3{$\cdot$}3 g/100 ml, and four studies suggested a negative association with nutritional status. Fat content ranged from 2{$\cdot$}1 to 9{$\cdot$}8 g/100 ml, and 68 \% of the studies reported positive associations with nutritional status. Carbohydrate content ranged from 5{$\cdot$}8 to 7{$\cdot$}5 g/100 ml, and 67 \% of the included studies did not report an association between intake and status. Literature investigating associations of maternal dietary intake and nutrition status with BM composition of macronutrients and energy content is diversified, both in terms of used methodology and results. Further studies using well-defined and standard parameters are essential to aid the formulation of scientific recommendations.},
  langid = {english},
  keywords = {breast milk,Dietary intake,Human breast milk,Macronutrients,Milk composition,Nutritional status},
  file = {C:\Users\andre\Zotero\storage\3Y2735A6\Adhikari et al. - 2022 - Maternal dietary intake, nutritional status and macronutrient composition of human breast milk syst.pdf}
}

