@article{allenReferenceValuesMinerals2025,
  title = {Reference {{Values}} for {{Minerals}} in {{Human Milk}}: The {{Mothers}}, {{Infants}} and {{Lactation Quality}} ({{MILQ}}) {{Study}}},
  shorttitle = {Reference {{Values}} for {{Minerals}} in {{Human Milk}}},
  author = {Allen, Lindsay H and Islam, M Munirul and Kac, Gilberto and Michaelsen, Kim F and Moore, Sophie E and Andersson, Maria and Peerson, Janet M and Doel, Andrew M and Dror, Daphna K and {Shahab-Ferdows}, Setareh and {de Barros Mucci}, Daniela and Silva, Gabriela Torres and Hampel, Daniela and M{\o}lgaard, Christian and Christensen, Sophie H and Lewis, Jack I and Tan, Xiuping and Dror, Daphna K and Doel, Andrew M and Schneider, Bruna C and Khanam, Farhana and {Divina de Souza Campos}, Adriana and Nije, Fanta and Hassan, Mehedi and Figueiredo, Amanda C},
  year = 2025,
  month = oct,
  journal = {Advances in Nutrition},
  series = {Reference {{Values}} for {{Nutrients}} in {{Human Milk}}: {{Results}} of the {{Mothers}}, {{Infants}} and {{Lactation Quality}} ({{MILQ}}) {{Study}}},
  volume = {16},
  pages = {100431},
  issn = {2161-8313},
  doi = {10.1016/j.advnut.2025.100431},
  urldate = {2025-12-20},
  abstract = {This fifth article in the series presenting reference values for nutrients in human milk describes minerals. The Mothers, Infants and Lactation Quality (MILQ) and Early-MILQ studies collected human milk samples throughout the first 8.5 mo of lactation in 1242 well-nourished women in Bangladesh, Brazil, Denmark, and The Gambia. All minerals were measured by inductively coupled plasma-mass spectrometry. Although pooled MILQ medians from 1 to 6 mo are within {$\sim$}10\% of the concentration used by the Institute of Medicine (IOM) for magnesium, potassium, calcium, and copper, they are {$\sim$}50\% of the IOM value for zinc and selenium, and {$\sim$}75\% of the IOM value for sodium and iron. For zinc, sodium, and iron, the discrepancy can be explained by the IOM's use of values from early lactation ({$<$}3 mo) when the milk nutrient concentrations are higher; in contrast, for potassium the IOM benchmark concentration is consistent with later lactation (6 mo) in MILQ. Pooled median MILQ phosphorus from 1 to 6 mo is 120\% of the concentration selected by the IOM. Milk iodine concentrations in MILQ varied among sites, reflecting the differing national policies for salt iodization. Total daily median mineral intakes from 1 to 6 mo were 49\%--55\% of IOM adequate intakes (AIs) for zinc and selenium, 74\%--90\% of AIs for sodium, iron, and magnesium, and 110\%--125\% of AIs for copper, potassium, calcium, and phosphorus. For zinc, sodium, iron, and potassium, differences can be explained by the reference time frame during lactation. The MILQ study mineral concentrations are provided as percentile curves to enable comparison and interpretation. Importantly, the MILQ data show marked changes in milk mineral concentrations during the first 6 mo of lactation, an observation often missed because of the absence of data representing a spectrum of time postpartum in previously published data.},
  keywords = {human milk,human milk nutrient concentration,infant intakes,infant mineral requirements,lactation,minerals,reference values},
  file = {C:\Users\andre\Zotero\storage\HBLYKCKF\S2161831325000675.html}
}

@article{allenReferenceValuesVitamins2025,
  title = {Reference {{Values}} for {{B Vitamins}} in {{Human Milk}}: {{The Mothers}}, {{Infants}} and {{Lactation Quality}} ({{MILQ}}) {{Study}}},
  shorttitle = {Reference {{Values}} for {{B Vitamins}} in {{Human Milk}}},
  author = {Allen, Lindsay H and {Shahab-Ferdows}, Setareh and Moore, Sophie E and Peerson, Janet M and Kac, Gilberto and Figueiredo, Amanda C and Dror, Daphna K and Michaelsen, Kim F and Islam, M Munirul and Nije, Fanta and Hampel, Daniela and Allen, Lindsay H and Moore, Sophie E and Kac, Gilberto and Michaelsen, Kim F and M{\o}lgaard, Christian and Islam, M Munirul and Andersson, Maria and {Shahab-Ferdows}, Setareh and Christensen, Sophie H and Lewis, Jack I and Peerson, Janet M and Tan, Xiuping and Dror, Daphna K and Doel, Andrew M and {de Barros Mucci}, Daniela and Schneider, Bruna C and Khanam, Farhana and {de Souza Campos}, Adriana Divina and Silva, Gabriela Torres and Nije, Fanta and Hassan, Mehedi and Figueiredo, Amanda C and Hampel, Daniela},
  year = 2025,
  month = oct,
  journal = {Advances in Nutrition},
  series = {Reference {{Values}} for {{Nutrients}} in {{Human Milk}}: {{Results}} of the {{Mothers}}, {{Infants}} and {{Lactation Quality}} ({{MILQ}}) {{Study}}},
  volume = {16},
  pages = {100500},
  issn = {2161-8313},
  doi = {10.1016/j.advnut.2025.100500},
  urldate = {2025-12-20},
  abstract = {This third article in the series presenting reference values (RVs) for nutrients in human milk describes the values for B vitamins. The mothers, infants, and lactation quality (MILQ) and early-MILQ studies, conducted at sites in Bangladesh, Brazil, Denmark, and The Gambia, were designed to measure human milk nutrient concentrations of well-nourished mothers during the first 8.5 mo of lactation. Applying ultrahigh-performance liquid chromatography--mass spectrometry (UPLC-MS/MS) to analyze multiple B vitamins simultaneously produced RVs for vitamin B2, B3, pantothenic acid, B6, and biotin. Choline was analyzed separately by UPLC-MS/MS, vitamin B1 by high-performance liquid chromatography--fluorescence detection, and vitamin B12 by competitive chemiluminescence enzyme immunoassay. Measured milk B-vitamin concentrations from the MILQ study were compared with those used by the Institute of Medicine (IOM) for setting recommendations for nutrient requirements of infants. MILQ estimates were substantially lower ({$<$}60\% of the concentrations used by the IOM) for vitamins B1, B2, and B6; 60\%--100\% of concentrations used by the IOM for vitamin B3, vitamin B12, and choline; and consistent or slightly (100\%--125\%) higher than concentrations used by the IOM for pantothenic acid and biotin. Total daily median B-vitamin intakes from 1 to 6 mo were 29\%--45\% of IOM adequate intakes (AIs) for vitamins B1 and B2, 60\%--75\% of AIs for vitamins B3, B6, B12, and choline, and 118\%--128\% of AIs for pantothenic acid and biotin. The MILQ B-vitamin concentrations are provided as percentile curves to enable comparison and interpretation of data from other studies.},
  keywords = {B vitamins,human milk,human milk nutrient concentration,infant nutrition,lactation,reference values},
  file = {C:\Users\andre\Zotero\storage\TBJMTVG5\S216183132500136X.html}
}

@article{allenVitaminsBreastMilk2012,
  title = {B {{Vitamins}} in {{Breast Milk}}: {{Relative Importance}} of {{Maternal Status}} and {{Intake}}, and {{Effects}} on {{Infant Status}} and {{Function12}}},
  shorttitle = {B {{Vitamins}} in {{Breast Milk}}},
  author = {Allen, Lindsay H.},
  year = 2012,
  month = may,
  journal = {Advances in Nutrition},
  volume = {3},
  number = {3},
  pages = {362--369},
  issn = {2161-8313},
  doi = {10.3945/an.111.001172},
  urldate = {2025-08-23},
  abstract = {Infants should be exclusively breastfed for the first 6 mo of life. However, maternal deficiency of some micronutrients, conveniently classified as Group I micronutrients during lactation, can result in low concentrations in breast milk and subsequent infant deficiency preventable by improving maternal status. This article uses thiamin, riboflavin, vitamin B-6, vitamin B-12, and choline as examples and reviews the evidence for risk of inadequate intakes by infants in the first 6 mo of life. Folate, a Group II micronutrient, is included for comparison. Information is presented on forms and concentrations in human milk, analytical methods, the basis of current recommended intakes for infants and lactating women, and effects of maternal supplementation. From reports of maternal and/or infant deficiency, concentrations in milk were noted as well as any consequences for infant function. These milk values were used to estimate the percent of recommended daily intake that infants fed by a deficient mother could obtain from her milk. Estimates were 60\% for thiamin, 53\% for riboflavin, 80\% for vitamin B-6, 16\% for vitamin B-12, and 56\% for choline. Lack of data limits the accuracy and generalizability of these conclusions, but the overall picture that emerges is consistent across nutrients and points to an urgent need to improve the information available on breast milk quality.},
  pmcid = {PMC3649471},
  pmid = {22585913},
  file = {C:\Users\andre\Zotero\storage\QI7TDB3Z\Allen - 2012 - B Vitamins in Breast Milk Relative Importance of Maternal Status and Intake, and Effects on Infant.pdf}
}

