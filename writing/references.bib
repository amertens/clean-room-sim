  keywords = {Birth Weight,Continental Population Groups,Developing Countries,Female,Gestational Age,Humans,Infant,Infant Low Birth Weight,Infant Mortality,Infant Newborn,Infant Small for Gestational Age,Male,Pregnancy,Prevalence,Quality Improvement,Quality of Health Care,Reference Values},
