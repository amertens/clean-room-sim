@article{rileyWorldHealthOrganization2016,
  title = {The {{World Health Organization STEPwise Approach}} to {{Noncommunicable Disease Risk-Factor Surveillance}}: {{Methods}}, {{Challenges}}, and {{Opportunities}}},
  shorttitle = {The {{World Health Organization STEPwise Approach}} to {{Noncommunicable Disease Risk-Factor Surveillance}}},
