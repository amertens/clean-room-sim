  keywords = {cross-design,Data Interpretation Statistical,evidence synthesis,Humans,IPD,Linear Models,meta-analysis,Meta-Analysis as Topic,Models Statistical,non-randomized intervention studies,NRSI,Proportional Hazards Models,Randomized Controlled Trials as Topic,RCT,review,Software,Treatment Outcome},
