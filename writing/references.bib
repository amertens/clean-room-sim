@article{swarthoutEffectsIndividualCombined2020,
  title = {Effects of {{Individual}} and {{Combined Water}}, {{Sanitation}}, {{Handwashing}}, and {{Nutritional Interventions}} on {{Child Respiratory Infections}} in {{Rural Kenya}}: {{A Cluster-Randomized Controlled Trial}}},
  shorttitle = {Effects of {{Individual}} and {{Combined Water}}, {{Sanitation}}, {{Handwashing}}, and {{Nutritional Interventions}} on {{Child Respiratory Infections}} in {{Rural Kenya}}},
  author = {Swarthout, Jenna and Ram, Pavani K. and Arnold, Charles D. and Dentz, Holly N. and Arnold, Benjamin F. and Kalungu, Stephen and Lin, Audrie and Njenga, Sammy M. and Stewart, Christine P. and Colford, John M. and Null, Clair and Pickering, Amy J.},
  year = 2020,
  month = jun,
  journal = {The American Journal of Tropical Medicine and Hygiene},
  volume = {102},
  number = {6},
  pages = {1286--1295},
  issn = {0002-9637},
  doi = {10.4269/ajtmh.19-0779},
  urldate = {2021-07-12},
  abstract = {Poor nutrition and hand hygiene are risk factors for acute respiratory infections (ARIs). Safe drinking water and sanitation can reduce exposure to pathogens and encourage healthy immune responses, reducing the risk of ARIs. Within a trial assessing impacts of water, sanitation, and handwashing (WASH), and nutritional interventions, we evaluated effects on ARIs. The WASH Benefits cluster-randomized trial enrolled pregnant women from Kenyan villages and evaluated health outcomes in children born to enrolled mothers 1 and 2 years after intervention delivery. Geographically adjacent clusters were block-randomized into a passive control (no promotional visits), a double-sized active control (monthly visits to measure mid--upper arm circumference), and six intervention groups: chlorinated drinking water (W), improved sanitation (S), handwashing with soap (H), combined WSH, improved nutrition (N) through counseling and lipid-based nutrient supplementation (LNS), and combined WSHN. The main outcome was the prevalence of ARI symptoms (cough, panting, wheezing, or difficulty breathing) in children younger than 3 years. Masking participants was not possible. Analyses were intention-to-treat. Between November 2012 and May 2014, 702 clusters were enrolled, including 6,960 (year 1) and 7,088 (year 2) children with ARI data. The cluster-level intra-cluster correlation coefficient for ARIs was 0.026 across both years. Water, sanitation, and handwashing interventions with behavior change messaging did not reduce ARIs. Nutrition counseling and LNS modestly reduced ARI symptoms compared with controls in year 1 [prevalence ratio (PR): 0.87, 95\% confidence interval (CI): 0.77--0.99], but no effect in the combined WSHN group weakens this finding.},
  pmcid = {PMC7253138},
  pmid = {32228789}
}

@article{taguriRiskFactorsStunting2009,
  title = {Risk Factors for Stunting among Under-Fives in {{Libya}}},
  author = {Taguri, Adel El and Betilmal, Ibrahim and Mahmud, Salah Murad and Ahmed, Abdel Monem and Goulet, Olivier and Galan, Pilar and Hercberg, Serge},
  year = 2009,
  month = aug,
  journal = {Public Health Nutrition},
  volume = {12},
  number = {8},
  pages = {1141--1149},
  issn = {1475-2727, 1368-9800},
  doi = {10.1017/S1368980008003716},
  urldate = {2018-10-02},
  abstract = {ObjectiveStunting is a chronic condition reflecting poor nutrition and health. Our aim was to ascertain major predictors of stunting in children {$<$}5 years old in Libya.Population and methodsA nationally representative, cross-sectional, two-stage stratified cluster sample survey enrolled 4549 under-fives from 6707 households. Logistic regression was used to determine individual risk factors in bivariate and multivariate analyses.ResultsAnthropometric measurements were available for 4498 children. Among the 929 stunted children (20{$\cdot$}7 \%), 495 were boys (53{$\cdot$}3 \%) and 434 were girls (46{$\cdot$}5 \%). In multivariate analysis, risk factors were young age (1--2 years: OR = 2{$\cdot$}32, 95 \% CI 1{$\cdot$}67, 3{$\cdot$}22; 2--3 years: OR = 1{$\cdot$}64, 95 \% CI 1{$\cdot$}22, 2{$\cdot$}21), resident of Al-Akhdar (OR = 1{$\cdot$}67, 95 \% CI 1{$\cdot$}08, 2{$\cdot$}58), being a boy (OR = 1{$\cdot$}28, 95 \% CI 1{$\cdot$}05, 1{$\cdot$}55), having a less educated father (illiterate: OR = 2{$\cdot$}10, 95 \% CI 1{$\cdot$}17, 3{$\cdot$}77; preparatory school: OR = 1{$\cdot$}71, 95 \% CI 1{$\cdot$}11, 2{$\cdot$}65), poor psychosocial stimulation (no family visits or trips: OR = 1{$\cdot$}52, 95 \% CI 1{$\cdot$}07, 2{$\cdot$}16; father rarely/never plays with child: OR = 2{$\cdot$}24, 95 \% CI 1{$\cdot$}20, 4{$\cdot$}16), filtered water (OR = 8{$\cdot$}45, 95 \% CI 2{$\cdot$}31, 30{$\cdot$}95), throwing garbage in the street (OR = 13{$\cdot$}81, 95 \% CI 2{$\cdot$}33, 81{$\cdot$}72), diarrhoea (OR = 1{$\cdot$}58, 95 \% CI 1{$\cdot$}09, 2{$\cdot$}29) and low birth weight (OR = 1{$\cdot$}8, 95 \% CI 1{$\cdot$}17, 2{$\cdot$}40). Protective factors were older age of father (OR = 0{$\cdot$}53, 95 \% CI 0{$\cdot$}32, 0{$\cdot$}90) and water storage (OR = 0{$\cdot$}70, 95 \% CI 0{$\cdot$}54, 0{$\cdot$}90). These variables only explained 20 \% of cases of stunting.ConclusionVarious multilevel actions are needed to improve nutritional status of under-fives in Libya. At risk-groups include those with young age (1--3 years), resident of Al-Akhdar region, boys, father's low educational level, poor psychosocial stimulation, poor housing environment, diarrhoea and low birth weight.},
  langid = {english},
  keywords = {Children,Libya,Risk factors,Stunting,Under-fives},
  file = {C\:\\Users\\andre\\Zotero\\storage\\BKY9B6T2\\Taguri et al. - 2009 - Risk factors for stunting among under-fives in Lib.pdf;C\:\\Users\\andre\\Zotero\\storage\\JV8NGZC7\\405B6DF9EFB1931EB90EF2223652FA07.html}
}

