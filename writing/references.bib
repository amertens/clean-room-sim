@article{nilssonEnvironmentallyInducedEpigenetic2012,
  title = {Environmentally {{Induced Epigenetic Transgenerational Inheritance}} of {{Ovarian Disease}}},
  author = {Nilsson, Eric and Larsen, Ginger and Manikkam, Mohan and {Guerrero-Bosagna}, Carlos and Savenkova, Marina I. and Skinner, Michael K.},
  year = 2012,
  month = may,
  journal = {PLoS ONE},
  volume = {7},
  number = {5},
  pages = {e36129},
  doi = {10.1371/journal.pone.0036129},
  urldate = {2014-10-30},
  abstract = {The actions of environmental toxicants and relevant mixtures in promoting the epigenetic transgenerational inheritance of ovarian disease was investigated with the use of a fungicide, a pesticide mixture, a plastic mixture, dioxin and a hydrocarbon mixture. After transient exposure of an F0 gestating female rat during embryonic gonadal sex determination, the F1 and F3 generation progeny adult onset ovarian disease was assessed. Transgenerational disease phenotypes observed included an increase in cysts resembling human polycystic ovarian disease (PCO) and a decrease in the ovarian primordial follicle pool size resembling primary ovarian insufficiency (POI). The F3 generation granulosa cells were isolated and found to have a transgenerational effect on the transcriptome and epigenome (differential DNA methylation). Epigenetic biomarkers for environmental exposure and associated gene networks were identified. Epigenetic transgenerational inheritance of ovarian disease states was induced by all the different classes of environmental compounds, suggesting a role of environmental epigenetics in ovarian disease etiology.},
  file = {C:\Users\andre\Zotero\storage\V42SPT7X\Nilsson et al. - 2012 - Environmentally Induced Epigenetic Transgeneration.pdf}
}

@article{njokanmaEarlyPostnatalGrowth2008,
  title = {Early Postnatal Growth of Preterm Low Birth Weight, Appropriately-Sized Infants},
  author = {Njokanma, O. F. and {Egri-Okwaji}, M. T. and Babalola, J. O.},
  year = 2008,
  month = jan,
  journal = {Nigerian Journal of Clinical Practice},
  volume = {11},
  number = {2},
  pages = {104},
  publisher = {Medknow Publications},
  issn = {1119-3077},
  urldate = {2020-11-18},
  abstract = {BACKGROUND: Postnatal growth monitoring is useful in assessing the health ofpreterm babies but their growth patterns have not been sufficiently studied in Africans. AIM: To describe the growth achievements ofpreterm, low birth weight, appropriately-sized, Nigerian infants. STUDY DESIGN: The subjects were prospectively recruited from two centers Olabisi Onabanjo University Teaching Hospital (January 1994 to June 1995) and Havana Specialist Hospital (June 1995 to June 1997). The weight, length and occipito-frontal circumference of 89 preterm, low birth weight, appropriate-for-dates infants were monitored from birth until 53 post-conceptual weeks. Growth velocities were compared with 46 term infants. RESULTS: Initial weight loss, age at regaining birth weight and growth rate in the early postnatal weeks were inversely related to gestational age. Subsequent weight gain was directly related to gestational age. Between birth and 40 weeks post conception, growth rates for different gestational age groups were 129 to 207 g/week (weight), 0.78 to 0.93 cm/week (length) and 0.62 to 0.65 cm/week (head circumference). After 40 weeks, the corresponding rates were 188 to 238 g/week, 0.86 to 0.96 cm week and 0.48 to 0.50 cm/week, respectively. Head growth demonstrated a faster catch-up than weight and body length in that order. The observed growth rates were slower in some respects than Caucasian figures but faster than reported for the Japanese. CONCLUSION: Study subjects had growth patterns within previously defined ranges. The better profile of western babies is probably related to better infrastructure while the advantage over Asian babies is probably racial.},
  langid = {english},
  pmid = {18817048},
  file = {C:\Users\andre\Zotero\storage\27VB42CR\article.html}
}

