@article{ibanezReducedUterineOvarian2000,
  title = {Reduced Uterine and Ovarian Size in Adolescent Girls Born Small for Gestational Age},
  author = {Ib{\'a}{\~n}ez, L. and Potau, N. and Enriquez, G. and {de Zegher}, F.},
