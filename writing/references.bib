  title = {In Utero and Lactational Exposure to Low-Dose Genistein-Vinclozolin Mixture Affects the Development and Growth Factor {{mRNA}} Expression of the Submandibular Salivary Gland in Immature Female Rats},
  author = {Kouidhi, Wided and Desmetz, Catherine and Nahdi, Afef and Berg{\`e}s, Raymond and Cravedi, Jean-Pierre and Auger, Jacques and El May, Mich{\`e}le and {Canivenc-Lavier}, Marie Chantal},
