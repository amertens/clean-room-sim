  title = {Maternal Depression and Early Childhood Growth in Developing Countries: Systematic Review and Meta-Analysis.},
  author = {{Surkan PJ} and {Kennedy CE} and {Hurley KM} and {Black MM}},
  year = 2011,
  journal = {Bull World Health Organ},
  volume = {89},
