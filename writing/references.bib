@article{saitouEpigeneticReprogrammingMouse2012,
  title = {Epigenetic Reprogramming in Mouse Pre-Implantation Development and Primordial Germ Cells},
  author = {Saitou, Mitinori and Kagiwada, Saya and Kurimoto, Kazuki},
  year = 2012,
  month = jan,
  journal = {Development},
  volume = {139},
