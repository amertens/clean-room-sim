@article{bertagnolliAdvantagesTrulyOpenAccess2017,
  title = {Advantages of a {{Truly Open-Access Data-Sharing Model}}},
  author = {Bertagnolli, Monica M. and Sartor, Oliver and Chabner, Bruce A. and Rothenberg, Mace L. and Khozin, Sean and {Hugh-Jones}, Charles and Reese, David M. and Murphy, Martin J.},
