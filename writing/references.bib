@article{perrellaHumanMilkComposition2021,
  title = {Human Milk Composition Promotes Optimal Infant Growth, Development and Health},
  author = {Perrella, Sharon and Gridneva, Zoya and Lai, Ching Tat and Stinson, Lisa and George, Alexandra and {Bilston-John}, Sabrina and Geddes, Donna},
