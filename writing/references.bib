@article{morganCaseTransgenerationalEpigenetic2008,
  title = {The Case for Transgenerational Epigenetic Inheritance in Humans},
  author = {Morgan, Daniel K. and Whitelaw, Emma},
  year = 2008,
  month = jun,
  journal = {Mammalian Genome},
  volume = {19},
  number = {6},
  pages = {394--397},
  issn = {0938-8990, 1432-1777},
  doi = {10.1007/s00335-008-9124-y},
  urldate = {2014-11-02},
  abstract = {Work in the laboratory mouse has identified a group of genes, called metastable epialleles, that are informing us about the mechanisms by which the epigenetic state is established in the embryo. At these alleles, transcriptional activity is dependent on the epigenetic state and this can vary from cell to cell in the one tissue type. The decision to be active or inactive is probabilistic and sensitive to environmental influences. Moreover, in some cases the epigenetic state at these alleles can survive across generations, termed transgenerational epigenetic inheritance. Together these findings raise the spectre of Lamarckism and epigenetics is now being touted as an explanation for some intergenerational effects in human populations. In this review we will discuss the evidence so far.},
  langid = {english},
  keywords = {Anatomy,Cell Biology,Zoology},
  file = {C\:\\Users\\andre\\Zotero\\storage\\WNF8AJHD\\Morgan and Whitelaw - 2008 - The case for transgenerational epigenetic inherita.pdf;C\:\\Users\\andre\\Zotero\\storage\\2PE5EDC9\\s00335-008-9124-y.html}
}

@article{moritaMouthingSoilContaminated2017,
  title = {Mouthing of {{Soil Contaminated Objects}} Is {{Associated}} with {{Environmental Enteropathy}} in {{Young Children}}},
  author = {Morita, Tomohiko and Perin, Jamie and Oldja, Lauren and Biswas, Shwapon and Sack, R. Bradley and Ahmed, Shahnawaz and Haque, Rashidul and Bhuiyan, Nurul Amin and Parvin, Tahmina and Bhuyian, Sazzadul Islam and Akter, Mahmuda and Talukder, Kaisar A. and Shahnaij, Mohammad and Faruque, Abu G. and George, Christine Marie},
  year = 2017,
  month = jun,
  journal = {Tropical medicine \& international health: TM \& IH},
  volume = {22},
  number = {6},
  pages = {670--678},
  issn = {1365-3156},
  doi = {10.1111/tmi.12869},
  abstract = {OBJECTIVE: To characterise childhood mouthing behaviours and to investigate the association between object-to-mouth and food-to-mouth contacts, diarrhoea prevalence and environmental enteropathy. METHODS: A prospective cohort study was conducted of 216 children {$\leq$}30 months of age in rural Bangladesh. Mouthing contacts with soil and food and objects with visible soil were assessed by 5-h structured observation. Stool was analysed for four faecal markers of intestinal inflammation: alpha-1-antitrypsin, myeloperoxidase, neopterin and calprotectin. RESULTS: Overall 82\% of children were observed mouthing soil, objects with visible soil, or food with visible soil during the structured observation period. Sixty two percent of children were observed mouthing objects with visible soil, 63\% were observed mouthing food with visible soil, and 18\% were observed mouthing soil only. Children observed mouthing objects with visible soil had significantly elevated faecal calprotectin concentrations (206.81 {$\mu$}g/g, 95\% confidence interval [CI]: 6.27, 407.36). There was also a marginally significant association between Escherichia coli counts in soil from a child's play space and the prevalence rate of diarrhoea (diarrhoea prevalence ratio: 2.03, 95\% CI 0.97, 4.25). CONCLUSION: These findings provide further evidence to support the hypothesis that childhood mouthing behaviour in environments with faecal contamination can lead to environmental enteropathy in susceptible paediatric populations. Furthermore, these findings suggest that young children mouthing objects with soil, which occurred more frequently than soil directly (60\% vs. 18\%), was an important exposure route to faecal pathogens and a risk factor for environmental enteropathy.},
  langid = {english},
  pmid = {28319300},
  keywords = {Bangladesh,Child Behavior,child behaviour,Child Preschool,comportamiento infantil,comportement de l'enfant,diarrea,Diarrhea,diarrhee,diarrhoea,enteropathie environnementale,enteropatia ambiental,environmental enteropathy,environmental exposure,Environmental Exposure,Escherichia coli,exposicion ambiental,exposition environnementale,Feces,Female,Humans,Infant,Inflammation,ingestion no dietaria,ingestion non alimentaire,Intestinal Diseases,Intestinal Mucosa,Intestines,Leukocyte L1 Antigen Complex,llevarse objetos a la boca,machonnement,Male,Mouth,mouthing,non-dietary ingestion,Play and Playthings,Prospective Studies,Rural Population,Soil,Soil Microbiology}
}

