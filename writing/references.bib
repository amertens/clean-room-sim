  author = {{Farfan-Garcia}, A. E. and Imdad, A. and ChengXian, Zhang and {Arias-Guerrero}, M. Y. and {Sanchez-Alvarez}, N. T. and Iqbal, J. and {Hernandez-Gamboa}, A. E. and Slaughter, J. C. and {Gomez-Duarte}, O. G.},
  year = 2020,
  journal = {PLoS Neglected Tropical Diseases},
