@article{guerrero-bosagnaEpigeneticTransgenerationalInheritance2012,
  title = {Epigenetic {{Transgenerational Inheritance}} of {{Vinclozolin Induced Mouse Adult Onset Disease}} and {{Associated Sperm Epigenome Biomarkers}}},
  author = {{Guerrero-Bosagna}, Carlos and Covert, Trevor R. and Haque, {\relax Md}. M. and Settles, Matthew and Nilsson, Eric E. and Anway, Matthew D. and Skinner, Michael K.},
  year = 2012,
  month = dec,
  journal = {Reproductive toxicology (Elmsford, N.Y.)},
  volume = {34},
  number = {4},
  pages = {694--707},
  issn = {0890-6238},
  doi = {10.1016/j.reprotox.2012.09.005},
  urldate = {2014-11-16},
  abstract = {The endocrine disruptor vinclozolin has previously been shown to promote epigenetic transgenerational inheritance of adult onset disease in the rat. The current study was designed to investigate the transgenerational actions of vinclozolin on the mouse. Transient exposure of the F0 generation gestating female during gonadal sex determination promoted transgenerational adult onset disease in F3 generation male and female mice, including spermatogenic cell defects, testicular abnormalities, prostate abnormalities, kidney abnormalities and polycystic ovarian disease. Pathology analysis demonstrated 75\% of the vinclozolin lineage animals developed disease with 34\% having two or more different disease states. Interestingly, the vinclozolin induced transgenerational disease was observed in the outbred CD-1 strain, but not the inbred 129 mouse strain. Analysis of the F3 generation sperm epigenome identified differential DNA methylation regions that can potentially be utilized as epigenetic biomarkers for transgenerational exposure and disease.},
  pmcid = {PMC3513496},
  pmid = {23041264},
  file = {C:\Users\andre\Zotero\storage\6GSVMM4E\Guerrero-Bosagna et al. - 2012 - Epigenetic Transgenerational Inheritance of Vinclo.pdf}
}

