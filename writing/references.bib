  issn = {1078-8956},
  doi = {10.1038/nm1108-1186},
  urldate = {2014-11-16},
  abstract = {Results from two independent groups of researchers have revolutionized our thinking about the potential long-term consequences of exposure to common foreign chemicals, or xenobiotics. The studies indicate that exposure to such chemicals during key windows of gestation can affect not only the children exposed in utero but also their children and perhaps even their grandchildren.},
