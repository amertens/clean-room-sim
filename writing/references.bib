  doi = {10.1056/NEJMsb1702054},
  urldate = {2019-10-17},
  abstract = {Multi-institutional randomized clinical trials have been a feature of oncology research in the United States since the 1950s. Since that time, cancer-treatment trials have been continuously funded by the National Cancer Institute (NCI) through a program that has evolved to become the National Clinical Trials Network (NCTN). Currently, approximately 19,000 patients with cancer participate in NCTN clinical trials each year. Approximately 70,000 additional patients with cancer are enrolled each year in treatment trials sponsored by the pharmaceutical industry.1,2 It is important to honor and reward the altruism of patients who participate in clinical trials. One way to do so . . .},
